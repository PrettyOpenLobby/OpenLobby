{
  "name": "OpenLobby Admin",
  "short_name": "OpenLobby",
  "description": "Operator dashboard: accounts, codes, GM calls, reports and news.",
  "id": "/",
  "start_url": "/#overview",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14161c",
  "theme_color": "#1c1f28",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "GM desk", "url": "/#gmcalls", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Accounts", "url": "/#accounts", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Codes", "url": "/#codes", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
