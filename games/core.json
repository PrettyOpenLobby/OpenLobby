{
  "schema": 1,
  "key": "core",
  "kind": "core",
  "name": "OpenLobby core (PlayOnline Viewer services)",
  "order": 0,
  "content_id": null,
  "platforms": ["pc", "ps2"],
  "repo": "https://github.com/PrettyOpenLobby/OpenLobby",
  "checkout": "openlobby",
  "compose": ["docker-compose.yml"],
  "compose_ghcr": ["docker-compose.ghcr.yml"],
  "env_example": ".env.example",
  "title": null,
  "images": [
    {"name": "openlobby:latest", "context": "services", "dockerfile": "Dockerfile",
     "ghcr": "ghcr.io/prettyopenlobby/openlobby", "tag_var": "OPENLOBBY_TAG"},
    {"name": "openlobby-ssl3:latest", "context": "services", "dockerfile": "Dockerfile.ssl3",
     "ghcr": "ghcr.io/prettyopenlobby/openlobby-ssl3", "tag_var": "OPENLOBBY_TAG"},
    {"name": "openlobby-sslterm:latest", "context": "services/sslterm", "dockerfile": "Dockerfile",
     "ghcr": "ghcr.io/prettyopenlobby/openlobby-sslterm", "tag_var": "OPENLOBBY_TAG"}
  ],
  "services": ["postgres", "valkey", "dns", "http", "ssl3web", "ssl3ucs", "sslterm", "ucs", "login",
               "authsess", "authrelay", "ucs-plain", "admin", "patch"],
  "profiles": {"gm": ["gmd"]},
  "env": [
    {"name": "POL_ADVERTISE", "default": "127.0.0.1",
     "description": "The address clients reach this host on (LAN, VPN or public IP). Every game falls back to it."},
    {"name": "POL_DB_PASSWORD", "default": "openlobby",
     "description": "Password of the bundled PostgreSQL. Set before the first start."},
    {"name": "POL_WWW", "default": "./www", "description": "Your portal content tree."},
    {"name": "POL_MIRRORS", "default": "./mirrors", "description": "Your patch mirror trees."},
    {"name": "POL_DNS_BIND", "default": "0.0.0.0",
     "description": "Address the DNS service binds port 53 on, when another resolver holds the wildcard."},
    {"name": "POL_SIGNUP_ANY_CODE", "default": "",
     "description": "1: the in-client sign-up accepts any registration code."},
    {"name": "OPENLOBBY_TAG", "default": "latest",
     "description": "Version of the published images (docker-compose.ghcr.yml)."}
  ],
  "data": [
    {"id": "portal", "required": false, "build_only": false,
     "description": "The portal pages the Viewer shows, from your own Viewer install.",
     "source": "PlayOnline Viewer install", "tool": "see README.md, \"Bring your own content\"",
     "paths": []},
    {"id": "mirrors", "required": false, "build_only": false,
     "description": "Patch trees for real updates; without them every title is answered as up to date.",
     "source": "an installed client", "tool": "docs/patching.md",
     "paths": []}
  ],
  "volumes": [],
  "ports": [
    {"port": "53", "protocol": "udp", "service": "dns", "host": "0.0.0.0"},
    {"port": "80", "protocol": "tcp", "service": "http", "host": "0.0.0.0"},
    {"port": "443", "protocol": "tcp", "service": "ssl3web", "host": "0.0.0.0"},
    {"port": "51305", "protocol": "tcp", "service": "ucs", "host": "0.0.0.0"},
    {"port": "51200-51240", "protocol": "tcp", "service": "login", "host": "0.0.0.0"},
    {"port": "51251-51271", "protocol": "tcp", "service": "login", "host": "0.0.0.0"},
    {"port": "51273-51304", "protocol": "tcp", "service": "login", "host": "0.0.0.0"},
    {"port": "51306-51310", "protocol": "tcp", "service": "login", "host": "0.0.0.0"},
    {"port": "51330", "protocol": "tcp", "service": "login", "host": "0.0.0.0"},
    {"port": "110", "protocol": "tcp", "service": "login", "host": "0.0.0.0"},
    {"port": "25", "protocol": "tcp", "service": "login", "host": "0.0.0.0"},
    {"port": "51241-51250", "protocol": "tcp", "service": "authrelay", "host": "0.0.0.0"},
    {"port": "8080", "protocol": "tcp", "service": "ucs-plain", "host": "127.0.0.1"},
    {"port": "8090", "protocol": "tcp", "service": "admin", "host": "127.0.0.1"},
    {"port": "54000", "protocol": "tcp", "service": "patch", "host": "0.0.0.0"},
    {"port": "53001-53015", "protocol": "tcp", "service": "patch", "host": "0.0.0.0"},
    {"port": "51112", "protocol": "udp", "service": "gmd", "host": "0.0.0.0", "profile": "gm"}
  ],
  "admin_module": "viewer",
  "notes": "Always part of the stack. Every game below runs in this project (--project-directory is this checkout) and uses its PostgreSQL, Valkey and data volume."
}
