# Copy to .env and edit. Every value here is optional; an EMPTY value always
# means "use the built-in default", never "empty string as the value".

# The address game clients use to reach this host. This is written into
# protocol replies (patch redirects, lobby handoffs), so it must be an address
# the CLIENT can route to: your LAN IP, VPN IP, or public IP.
# Default when empty: 127.0.0.1 (same-machine testing only).
POL_ADVERTISE=

# Where your portal content tree lives (you supply this; see README.md).
# Default: ./www
POL_WWW=

# Where your patch mirror trees live (you supply this; see README.md).
# Default: ./mirrors
POL_MIRRORS=

# Password of the bundled PostgreSQL service (user and database "openlobby").
# Set it before the first `docker compose up`: the database keeps the password
# it was created with, so changing it later means changing it inside Postgres
# too. Use letters and digits; it is written into a URL.
# Default when empty: openlobby.
POL_DB_PASSWORD=

# Admin dashboard credentials (the admin service listens on 127.0.0.1 only).
POL_ADMIN_USER=admin
POL_ADMIN_PASSWORD=

# Bind address for the DNS service's port 53. Set this to the server's LAN
# IP if another resolver on the host already occupies port 53 (WSL and some
# systemd-resolved setups). Default: all addresses.
POL_DNS_BIND=

# Permissive sign-up: "1" makes the in-client "Join PlayOnline" wizard accept
# ANY registration code and grant the new account every title this server
# offers (POL_LOBBY_CONTENT_IDS). For a private server among friends. Default
# (empty): only codes minted on the admin panel work, and each code carries
# its own grants.
POL_SIGNUP_ANY_CODE=

# Optional registration code: "permissive" lets the wizard's code step be left
# empty, and such an account is granted POL_SIGNUP_CONTENTS (a comma list of
# content codes; empty = every title this server offers). A code that IS typed
# is still checked. Default (empty): "code", SE's flow.
POL_SIGNUP_MODE=
POL_SIGNUP_CONTENTS=

# Mail to and from the internet (services/extmail.py). Off unless BOTH an
# outbound SMTP relay (host:port, a mail server that signs and delivers for
# your outside domain) and the outside domain itself are set; each member must
# then also be enabled on the admin panel. Inbound mail arrives when the
# domain's MX delivers to this server's port 25; POL_EXT_MAIL_IN_PER_IP_HOUR
# caps outside messages per sending address per hour (default 60).
POL_EXT_MAIL_RELAY=
POL_EXT_MAIL_DOMAIN=
POL_EXT_MAIL_DAILY_OUT=
POL_EXT_MAIL_DAILY_IN=
POL_EXT_MAIL_IN_PER_IP_HOUR=

# Leave disc-only files out of a PS2 title's patch list, e.g. "P2U/0004".
POLP_SLIM_LIST=

# The version the patch service reports to a Viewer (product 1000) whose
# version check arrives empty, as it can on a re-login, e.g. "20130104_0".
# Default (empty): the empty version is echoed back.
POLP_FALLBACK_VERSION=

# Leave file-list rows newer than this out of the console Viewer trees you
# supply (PS2, P2U, X2U, XB2). Default: 20130601_E.
POLP_CONSOLE_LIST_CAP=

# What a login does when the account database cannot be read. Default
# (empty): it continues without an account (no games menu). "refuse" answers
# "server busy" instead, which also keeps refused accounts out during an
# outage. Per-account refusals and login notices are set on the admin panel
# or with `accounts.py - reject-code` / `notice-code`.
POL_ACCOUNTS_DB_FAIL=

# Login and lobby switches learned from Project Crystal Server. All off when
# empty; docker-compose.yml says what each one does, and services/responders.py
# documents them at the knob. Turn one on at a time and watch the logs.
POL_AUTH_RSA=
POL_AUTH_RSA_IPS=
POL_AUTH_KILL_DUP=
POL_AUTH_KILL_DUP_SCOPE=
POL_GATE_LIST_STAMPS=
POL_PROFILE_TRAILER=
POL_HANDLE_STORE_LAYOUT=
POL_HANDLE_STORE_DELETE=
POL_FRIEND_BITFIELD=
POL_FRIEND_REQUEST_HEAL=
POL_FRIEND_REQUEST_HEAL_TTL=
