# Copy to .env and edit. Every value here is optional; an EMPTY value always
# means "use the built-in default", never "empty string as the value".

# The address game clients use to reach this host. This is written into
# protocol replies (patch redirects, lobby handoffs), so it must be an address
# the CLIENT can route to: your LAN IP, VPN IP, or public IP.
# It wins over stub_ip in config/server.yaml. docs/configuration.md has the
# details.
# Default when empty: 127.0.0.1 (same-machine testing only).
POL_ADVERTISE=

# Per-network addresses, for players arriving by more than one route. All off
# when unset. POL_ADVERTISE_PUBLIC goes to clients with a public internet
# address; POL_ADVERTISE_LAN to clients inside POL_ADVERTISE_LAN_CLIENTS (a
# CIDR list, default the private ranges).
# POL_ADVERTISE_PUBLIC=
# POL_ADVERTISE_LAN=
# POL_ADVERTISE_LAN_CLIENTS=

# Where your portal content tree lives (you supply this; see README.md).
# Default: ./www
POL_WWW=

# Where your patch mirror trees live (you supply this; see README.md).
# Default: ./mirrors
POL_MIRRORS=

# Password of the bundled PostgreSQL service (user and database "openlobby").
# Set it before the first `docker compose up`: the database keeps the password
# it was created with, so changing it later means changing it inside Postgres
# too. Use letters and digits; it is written into a URL.
# Default when empty: openlobby.
POL_DB_PASSWORD=

# Admin panel break-glass login (the panel is published on 127.0.0.1:8090
# only). The normal credential is set with
#   docker compose exec admin python admin.py --set-password
# and kept in the database; until one exists the panel answers 503. A
# non-empty POL_ADMIN_PASSWORD always logs in as POL_ADMIN_USER.
POL_ADMIN_USER=admin
POL_ADMIN_PASSWORD=

# Bind address for the DNS service's port 53. Set this to the server's LAN
# IP if another resolver on the host already occupies port 53 (WSL and some
# systemd-resolved setups), or to keep it off a public interface.
# Default: all addresses.
POL_DNS_BIND=

# Who the DNS service answers. It forwards names it does not redirect, so an
# unrestricted one is an open resolver: never set 0.0.0.0/0 on a box with a
# public address. POL_DNS_CLIENTS is a CIDR list that REPLACES the default
# (loopback plus the private ranges). POL_DNS_PUBLIC=1 also answers internet
# clients, but only for the redirected PlayOnline names, at most
# POL_DNS_PUBLIC_RATE queries per address per 10 seconds; it needs
# POL_ADVERTISE_PUBLIC. See docs/configuration.md for VPN and internet recipes.
# POL_DNS_CLIENTS=
# POL_DNS_PUBLIC=0
# POL_DNS_PUBLIC_RATE=60

# Permissive sign-up: "1" makes the in-client "Join PlayOnline" wizard accept
# ANY registration code and grant the new account every title this server
# offers (POL_LOBBY_CONTENT_IDS). For a private server among friends. Default
# (empty): only codes minted on the admin panel work, and each code carries
# its own grants.
POL_SIGNUP_ANY_CODE=

# Optional registration code: "permissive" lets the wizard's code step be left
# empty, and such an account is granted POL_SIGNUP_CONTENTS (a comma list of
# content codes; empty = every title this server offers). A code that IS typed
# is still checked. Default (empty): "code", SE's flow.
POL_SIGNUP_MODE=
POL_SIGNUP_CONTENTS=

# Sign-up limits. Accounts created per 24 hours by the whole service, and per
# public address (private addresses are not counted); refused registration
# codes from one address before it must wait POL_REGCODE_LOCKOUT_WINDOW_S
# seconds. 0 turns each off.
# POL_SIGNUP_PER_DAY=50
# POL_SIGNUP_PER_IP=3
# POL_REGCODE_LOCKOUT_FAILS=5
# POL_REGCODE_LOCKOUT_WINDOW_S=900

# Login lockout: this many failed Viewer logins on one account inside the
# window (seconds) locks it until they age out. 0 turns it off. Unlock early
# with `docker compose exec login python accounts.py unlock <POL ID>`.
# POL_LOGIN_LOCKOUT_FAILS=5
# POL_LOGIN_LOCKOUT_WINDOW_S=900

# A Viewer login token binds only to an armed account (README, Troubleshooting).
# 0 turns the check off.
# POL_TOKEN_ARM=1

# Connection caps per service process: all connections, and per client
# address. 0 removes a cap.
# POL_MAX_CONNS=256
# POL_MAX_CONNS_PER_IP=32

# Built-in portal pages for pages missing from www/ (0 = off), and a GM Call
# entry on the built-in menu (1 = on; start the gm profile too).
# POL_PML_FALLBACK=1
# POL_GM_CALL=0

# Log rotation in the pol-logs volume: size in MB before a log rotates
# (0 = never), and rotated copies kept.
# POL_LOG_MAX_MB=8
# POL_LOG_KEEP=3

# Mail to and from the internet (services/extmail.py). Off unless both an
# outbound SMTP relay (host:port, a mail server that signs and delivers for
# your outside domain) and the outside domain itself are set; each member must
# then also be enabled on the admin panel. Inbound mail arrives when the
# domain's MX delivers to this server's port 25; POL_EXT_MAIL_IN_PER_IP_HOUR
# caps outside messages per sending address per hour (default 60). The daily
# caps are per member: 20 out and 100 in when empty.
POL_EXT_MAIL_RELAY=
POL_EXT_MAIL_DOMAIN=
POL_EXT_MAIL_DAILY_OUT=
POL_EXT_MAIL_DAILY_IN=
POL_EXT_MAIL_IN_PER_IP_HOUR=

# Leave disc-only files out of a PS2 title's patch list, e.g. "P2U/0004".
POLP_SLIM_LIST=

# The version the patch service reports to a Viewer (product 1000) whose
# version check arrives empty, as it can on a re-login, e.g. "20130104_0".
# Default (empty): the empty version is echoed back.
POLP_FALLBACK_VERSION=

# Leave file-list rows newer than this out of the console Viewer trees you
# supply (PS2, P2U, X2U, XB2). Default: 20130601_E.
POLP_CONSOLE_LIST_CAP=

# What a login does when the account database cannot be read. Default
# (empty): it continues without an account (no games menu). "refuse" answers
# "server busy" instead, which also keeps refused accounts out during an
# outage. Per-account refusals and login notices are set on the admin panel
# or with `accounts.py - reject-code` / `notice-code`.
POL_ACCOUNTS_DB_FAIL=

# Protocol switches for client-compatibility experiments, read by the login
# and lobby services. All off when empty, which is how the server is meant to
# run; docker-compose.yml and services/responders.py describe each one.
POL_AUTH_RSA=
POL_AUTH_RSA_IPS=
POL_AUTH_KILL_DUP=
POL_AUTH_KILL_DUP_SCOPE=
POL_GATE_LIST_STAMPS=
POL_PROFILE_TRAILER=
POL_HANDLE_STORE_LAYOUT=
POL_HANDLE_STORE_DELETE=
POL_FRIEND_BITFIELD=
POL_FRIEND_REQUEST_HEAL=
POL_FRIEND_REQUEST_HEAL_TTL=

# Run the published images instead of building (needs Docker Compose 2.24+),
# and which version of them. See README.md.
# COMPOSE_FILE=docker-compose.yml:docker-compose.ghcr.yml
# OPENLOBBY_TAG=latest

# The deployer, which installs, enables, updates and restarts games from the
# admin panel (docs/deployer.md). Off unless you start its profile:
#   docker compose --profile deployer up -d deployer
# POL_DEPLOYER_TOKEN is required by it and given to the admin panel too; make
# one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# POL_DEPLOY_ROOT is the absolute path of the directory that holds this
# checkout and the game checkouts beside it, e.g. /srv/pol for /srv/pol/openlobby.
# On Docker Desktop for Windows it is that folder as Docker's VM sees it, e.g.
# /run/desktop/mnt/host/c/Users/you/openlobby-server for
# C:\Users\you\openlobby-server; setup.ps1 writes it, and POL_DEPLOY_CORE and
# POL_DEPLOY_CLIENTS, that way.
# POL_DEPLOY_GHCR=1 makes its actions run the published images (no --build).
# POL_DEPLOY_CLIENTS is the absolute path of a folder you keep client installs
# in (e.g. /srv/clients); the panel can then pick one to import a game's data
# from. It is mounted read-only. Unset, the panel takes uploaded archives only.
# POL_DEPLOY_UPLOAD_MAX caps an uploaded archive, unpacked (default 8G).
# POL_DEPLOYER_TOKEN=
# POL_DEPLOY_ROOT=
# POL_DEPLOY_GHCR=
# POL_DEPLOY_CLIENTS=
# POL_DEPLOY_UPLOAD_MAX=8G
# The dev update channel (docs/deployer.md, "Dev channel"): the developers'
# preview builds, read with an access code you enter in Settings > Install games
# > Update channel (the deployer keeps the code, never .env).
# POL_DEV_REGISTRY is the dev registry they give you, host/path; unset, the panel
# asks for it with the code. POL_DEV_SOURCE is where the source of the dev images
# is (default https://<POL_DEV_REGISTRY>). POL_DEV_USER is the user name a bare
# code signs in under (default dev).
# POL_DEV_REGISTRY=
# POL_DEV_SOURCE=
# POL_DEV_USER=
